                android:valueFrom="0.55"
                android:valueTo="1"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator
                        android:controlX1="0.16"
                        android:controlY1="1"
                        android:controlX2="0.3"
                        android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="codex_shape">
