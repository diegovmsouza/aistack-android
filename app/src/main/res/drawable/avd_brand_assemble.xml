                        android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
            <objectAnimator
                android:duration="720"
                android:propertyName="translateX"
                android:startOffset="140"
                android:valueFrom="-120"
                android:valueTo="0"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
